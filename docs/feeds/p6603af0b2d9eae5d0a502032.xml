  <item>
    <title>010.有思考力有生命力，更有理想主义。</title>
    <link>https://www.xiaoyuzhoufm.com/episode/6734c831f373fe5d4d12379a</link>
    <guid isPermaLink="false">6734c831f373fe5d4d12379a</guid>
    <pubDate>Wed, 13 Nov 2024 16:02:59 +0000</pubDate>
