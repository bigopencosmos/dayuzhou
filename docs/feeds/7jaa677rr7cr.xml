  <item>
    <title>Vol.005 YE与adidas分手是为了成就更好的自己？（下）</title>
    <link>https://www.xiaoyuzhoufm.com/episode/639869213a2b7eba5ceb45e6</link>
    <guid isPermaLink="false">639869213a2b7eba5ceb45e6</guid>
    <pubDate>Tue, 13 Dec 2022 11:59:28 +0000</pubDate>
