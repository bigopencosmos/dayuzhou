    <itunes:duration>00:11:11</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fu7jXBje0opk1OKpi9Spn5qzImWZ.jpg"/>
    <itunes:explicit>false</itunes:explicit>
