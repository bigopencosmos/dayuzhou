    <itunes:duration>01:27:30</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0Z0UHdlRnhOVXNQUWdmV096NEhXT09aazdwRmQucG5n.png"/>
