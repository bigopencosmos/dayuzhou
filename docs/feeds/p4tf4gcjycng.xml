    <itunes:duration>01:06:47</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fi-NrOkMRGcU-NG8WNNoTWmGR-PH.jpg"/>
    <itunes:explicit>false</itunes:explicit>
