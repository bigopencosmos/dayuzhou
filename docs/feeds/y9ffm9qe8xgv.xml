  <item>
    <title>我可以用十五个香蕉玛芬换你的一本书吗｜EP002</title>
    <link>https://www.xiaoyuzhoufm.com/episode/640c9f1b092eb63cb06050eb</link>
    <guid isPermaLink="false">640c9f1b092eb63cb06050eb</guid>
