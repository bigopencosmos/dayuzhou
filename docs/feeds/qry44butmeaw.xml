    <itunes:duration>00:13:12</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0Zya1lCSGZQM2puckcya2UzX3JoNVh4TVFzaXEucG5n.png"/>
