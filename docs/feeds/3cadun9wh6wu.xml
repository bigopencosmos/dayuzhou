    <itunes:duration>00:43:26</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fgp5YFqvHcymGgd4yRtV3YrvPHIc.jpg"/>
    <itunes:explicit>false</itunes:explicit>
