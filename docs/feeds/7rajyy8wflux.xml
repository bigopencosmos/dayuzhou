    <itunes:explicit>false</itunes:explicit>
  </item>
  <item>
    <title>人工智能文学是人类的照妖镜（下）</title>
    <link>https://www.xiaoyuzhoufm.com/episode/664498a582b428eafdcb832b</link>
    <guid isPermaLink="false">664498a582b428eafdcb832b</guid>
    <pubDate>Wed, 15 May 2024 11:12:37 +0000</pubDate>
    <enclosure url="https://media.xyzcdn.net/lkCIttVrn6zfmErXch_7KYYnUSQc.m4a" length="56803729" type="audio/mp4"/>
    <itunes:duration>00:29:25</itunes:duration>
