    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZydEh5bjB1RFYwbjNjZ1pES2tjb04xc0k0bGsucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
