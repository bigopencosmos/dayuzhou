    <itunes:duration>01:31:49</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FuhgLC0UxMlcX9gZwnrYLkl47Gx4.jpg"/>
    <itunes:explicit>false</itunes:explicit>
