    <itunes:duration>00:37:37</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FoKhkcGb2SDLimmWiI6FrI5tb7Pm.png"/>
    <itunes:explicit>false</itunes:explicit>
