  <item>
    <title>看世界 | 迪拜Citywalk：阿联酋高温旅行的七天零七夜</title>
    <link>https://www.xiaoyuzhoufm.com/episode/64bd1be25680f4d4a880f3e9</link>
    <guid isPermaLink="false">64bd1be25680f4d4a880f3e9</guid>
    <pubDate>Sun, 23 Jul 2023 12:24:01 +0000</pubDate>
