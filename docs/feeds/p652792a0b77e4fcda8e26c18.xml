    <itunes:duration>01:07:43</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FiiGBLN07vRRU0wC-Mu7BYvBJFOY.png"/>
    <itunes:explicit>false</itunes:explicit>
