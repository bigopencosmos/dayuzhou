    <itunes:duration>01:13:12</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L2x1U2E1YTdqRml0cEJPNDAzeWtoNEdKY0xsVW0ucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
