    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZsN2lmRFM1Mng4MjNhbDlNZnZtRTdCYkNzdnAucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
