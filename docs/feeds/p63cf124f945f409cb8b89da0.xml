    <itunes:duration>00:31:02</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZqMmVBYjFLaERpNm1SUHlIZXhKdTZQV3JyeVEucG5n.png"/>
