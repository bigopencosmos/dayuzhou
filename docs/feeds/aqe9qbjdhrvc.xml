  <item>
    <title>#153 软件史实故事E29：数字图像帝国｜Photoshop与Adobe公司的故事</title>
    <link>https://www.xiaoyuzhoufm.com/episode/6abe3a58e742e36efcbd7ce4</link>
    <guid isPermaLink="false">6abe3a58e742e36efcbd7ce4</guid>
    <pubDate>Sun, 04 Oct 2026 23:00:00 +0000</pubDate>
