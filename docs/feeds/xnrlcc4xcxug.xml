    <itunes:duration>00:42:25</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fsct4EPVqPJKDtI-LVOWmnDfJL7S.png"/>
    <itunes:explicit>false</itunes:explicit>
