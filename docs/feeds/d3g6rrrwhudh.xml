    <itunes:duration>02:03:19</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FprD1l2wAwvPaFQX8Y-rIRNvj_J1.jpg"/>
    <itunes:explicit>false</itunes:explicit>
