  <item>
    <title>067.罗马的斯多葛主义和哲人传奇</title>
    <link>https://www.xiaoyuzhoufm.com/episode/670f7670db2cf82757a5a77b</link>
    <guid isPermaLink="false">670f7670db2cf82757a5a77b</guid>
    <pubDate>Wed, 16 Oct 2024 08:16:47 +0000</pubDate>
