    <itunes:duration>00:58:53</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FrJL6cXwbl5O1GsIB0EuvcGSRDkG.jpg"/>
    <itunes:explicit>false</itunes:explicit>
