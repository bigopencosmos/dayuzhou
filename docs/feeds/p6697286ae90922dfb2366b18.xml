    <itunes:duration>00:52:00</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FvUsH7Cb3dtwp3iJZGkwM1CE2UE7.png"/>
    <itunes:explicit>false</itunes:explicit>
