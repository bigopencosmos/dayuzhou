    <itunes:duration>00:52:03</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FnIHSgGm1EtgjppQeGVFycWJY2EL.jpg"/>
    <itunes:episode>32</itunes:episode>
    <itunes:explicit>false</itunes:explicit>
