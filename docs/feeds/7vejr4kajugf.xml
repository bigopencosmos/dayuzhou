    <itunes:duration>00:32:08</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZxaXRwVnJPaFRNZC1NbkthUmRzQnpMbUVOcGMucG5n.png"/>
