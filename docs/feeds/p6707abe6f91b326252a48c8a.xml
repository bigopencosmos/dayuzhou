    <itunes:duration>01:07:01</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fpx6mI8m9aXOv9nQrFVHVUnoxGFu.jpeg"/>
    <itunes:episode>55</itunes:episode>
