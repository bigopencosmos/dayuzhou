    <itunes:duration>00:45:12</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FvhIYEHSi7m9hrDBOk5-IFIPNLLg.png"/>
    <itunes:explicit>false</itunes:explicit>
