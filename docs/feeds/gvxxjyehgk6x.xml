    <itunes:duration>00:47:01</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fq43vGf3t0oDOQR9iFBqFCI0sWWd.png"/>
    <itunes:explicit>false</itunes:explicit>
