    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0Z0RjFWTzhRVFphUHpDMzQ4VXhtQ1hCYU9MM3EucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
