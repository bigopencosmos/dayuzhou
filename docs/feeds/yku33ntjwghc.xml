    <itunes:duration>00:56:43</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fos8_hn1LYCyGBwkQtqvzm9SU1Pw.jpg"/>
    <itunes:explicit>false</itunes:explicit>
