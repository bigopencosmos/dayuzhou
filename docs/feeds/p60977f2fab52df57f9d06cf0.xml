    <itunes:duration>02:02:03</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FkyMnR-5h_xruHu3PB2vZsLm22T-.jpg"/>
    <itunes:episode>129</itunes:episode>
    <itunes:explicit>false</itunes:explicit>
