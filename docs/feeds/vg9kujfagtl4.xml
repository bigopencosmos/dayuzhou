    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZyYjh4aUNWY1UtUFI3TzZRdElpYmVObldEQW0ucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
