    <itunes:duration>00:57:37</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FhGoUBXpBZyiYbfLZBOyaiBsMA09.jpg"/>
    <itunes:explicit>false</itunes:explicit>
  </item>
