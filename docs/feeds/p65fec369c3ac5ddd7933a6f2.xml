  <item>
    <title>第85站-生气是拿别人的错误（不是）惩罚自己</title>
    <link>https://www.xiaoyuzhoufm.com/episode/6a2b9b304233e62bc54890ed</link>
    <guid isPermaLink="false">6a2b9b304233e62bc54890ed</guid>
