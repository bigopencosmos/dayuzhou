    <itunes:duration>00:48:51</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Ft09JPLLO_X8v3TIIMl8i01lTy6s.jpg"/>
    <itunes:explicit>false</itunes:explicit>
