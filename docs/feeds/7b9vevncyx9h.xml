    <itunes:duration>00:42:08</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FnaEMG9tGTbLSfzpoutZVYcv2nWy.jpg"/>
    <itunes:explicit>false</itunes:explicit>
