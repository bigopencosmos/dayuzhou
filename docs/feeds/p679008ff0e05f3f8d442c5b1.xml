    <itunes:duration>00:46:01</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FjhUM2UGj3HpukcD1u2GyGVMEBcr.jpg"/>
    <itunes:explicit>false</itunes:explicit>
