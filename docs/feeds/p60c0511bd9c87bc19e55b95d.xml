    <itunes:duration>01:07:00</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FnCqqs9a-gHBjhmyIN2JOsa5YkHX.jpg"/>
    <itunes:explicit>false</itunes:explicit>
