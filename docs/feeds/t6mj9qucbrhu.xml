    <itunes:duration>01:00:46</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZzRDkyZkxWS0M5ZWVZRm5oTGRGWXlSZHdUcjEucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
