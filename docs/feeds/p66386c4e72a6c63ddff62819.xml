  <item>
    <title>EP07《原则：应对变化中的世界秩序》：万变不离其宗</title>
    <link>https://www.xiaoyuzhoufm.com/episode/6744a9b511045e78e5dfe7ad</link>
    <guid isPermaLink="false">6744a9b511045e78e5dfe7ad</guid>
