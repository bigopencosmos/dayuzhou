    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZsQ3JpNmhTVndoTUFOcDF1MGhyZzZOVjRxSTYucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
  </item>
  <item>
    <title>决胜伦敦 E08.青岛号绕过苏格兰北部海角现场，直奔伦敦</title>
    <link>https://www.xiaoyuzhoufm.com/episode/6331cd832a992d56e91e50c4</link>
