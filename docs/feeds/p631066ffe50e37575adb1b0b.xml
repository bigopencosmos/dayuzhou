    <itunes:duration>00:37:22</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZsRjNQMXVvSTJfNVdfbDR5VnBRRWRvM0l2eE4ucG5n.png"/>
