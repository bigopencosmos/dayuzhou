    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZpeUhjMWwxNklEYUI0OEJOMG5yTGRrWS1JOU0ucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
