    <itunes:duration>00:56:29</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FvUB0zOmrFWCzRQtXFDGzpGP_Spn.jpg"/>
    <itunes:explicit>false</itunes:explicit>
