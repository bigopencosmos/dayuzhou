  <item>
    <title>ep122-双十一2026：我们的年度网购盘点（feat 核桃女王· 胡）</title>
    <link>https://www.xiaoyuzhoufm.com/episode/6adfe38dc96c8942ec12b1ed</link>
    <guid isPermaLink="false">6adfe38dc96c8942ec12b1ed</guid>
    <pubDate>Wed, 28 Oct 2026 16:00:00 +0000</pubDate>
