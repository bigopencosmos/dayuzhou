    <itunes:duration>01:01:30</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FkgJ_ClN6IXn9XALjT9VB7HnFArq.jpg"/>
    <itunes:explicit>false</itunes:explicit>
