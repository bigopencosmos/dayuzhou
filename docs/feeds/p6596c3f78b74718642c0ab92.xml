    <itunes:duration>00:45:00</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fr78T945CmD3VBkHo7j2O-a8vsSS.jpg"/>
    <itunes:explicit>false</itunes:explicit>
