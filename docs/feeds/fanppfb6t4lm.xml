    <itunes:duration>00:41:11</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FgFabOWo2TbxSur686D6Mf4BVpMQ.jpg"/>
    <itunes:explicit>false</itunes:explicit>
