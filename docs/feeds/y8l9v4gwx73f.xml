  <item>
    <title>EP021 新年第一次旅行，清迈小野人出发！</title>
    <link>https://www.xiaoyuzhoufm.com/episode/65bef022dde969cfdc4c6789</link>
    <guid isPermaLink="false">65bef022dde969cfdc4c6789</guid>
    <pubDate>Sun, 04 Feb 2024 09:00:00 +0000</pubDate>
