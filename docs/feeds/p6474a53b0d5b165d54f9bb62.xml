  <item>
    <title>005｜城市嬉皮士和神经紧绷者的鞋履消费史</title>
    <link>https://www.xiaoyuzhoufm.com/episode/64b7ba44d0844ea8120077ad</link>
    <guid isPermaLink="false">64b7ba44d0844ea8120077ad</guid>
    <pubDate>Wed, 19 Jul 2023 10:26:09 +0000</pubDate>
