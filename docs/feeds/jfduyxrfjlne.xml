    <itunes:duration>00:59:44</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FjyUzoaDpyfmrYl6DWy_Otr6PCzR.jpg"/>
    <itunes:explicit>false</itunes:explicit>
