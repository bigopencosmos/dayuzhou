    <itunes:duration>00:33:42</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0ZwNW5IZVc5ZzF4YW1TS0YxTjM0OXRva2FGNW4ucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
