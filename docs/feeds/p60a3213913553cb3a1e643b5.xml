    <itunes:duration>00:42:47</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/60a3213913553cb3a1e643b5/FnrAw8URYAuuc_2l_C_vD2gkjbQP.jpg"/>
    <itunes:explicit>false</itunes:explicit>
