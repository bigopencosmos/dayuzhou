    <itunes:duration>00:56:35</itunes:duration>
    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0Z0OHlXR0lOOEQ5Ml9wSXY4ZUNCNFJ4eS1zVEUucG5n.png"/>
