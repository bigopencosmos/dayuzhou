    <itunes:duration>01:07:34</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/FsP1ilMqhYkueuqWTRhfkD4xOPBz.jpg"/>
    <itunes:explicit>false</itunes:explicit>
