    <itunes:image href="https://bts-image.xyzcdn.net/aHR0cHM6Ly9pbWFnZS54eXpjZG4ubmV0L0Z2SThPTXNxM0VBN2FoaWpScUFSYkJzeUUyQXAucG5n.png"/>
    <itunes:explicit>false</itunes:explicit>
