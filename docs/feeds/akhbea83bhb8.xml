    <itunes:duration>00:43:31</itunes:duration>
    <itunes:image href="https://image.xyzcdn.net/Fv3ypDMGm7xyD2SEhy1y3OHM8Hk6.png"/>
    <itunes:explicit>false</itunes:explicit>
